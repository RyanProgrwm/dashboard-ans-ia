{
  "name": "ANS Noite",
  "dataColors": [
    "#22D3EE",
    "#A78BFA",
    "#F472B6",
    "#FBBF24",
    "#34D399",
    "#60A5FA",
    "#F87171",
    "#2DD4BF",
    "#FB923C",
    "#C084FC",
    "#4ADE80",
    "#38BDF8"
  ],
  "background": "#0A1020",
  "foreground": "#E2E8F0",
  "tableAccent": "#22D3EE",
  "good": "#34D399",
  "neutral": "#FBBF24",
  "bad": "#F87171",
  "maximum": "#22D3EE",
  "center": "#0E7490",
  "minimum": "#0F172A",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E2E8F0"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E2E8F0"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#CBD5E1"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#141D33"
              }
            },
            "foreground": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "transparency": 0
          }
        ],
        "visualTooltip": [
          {
            "background": {
              "solid": {
                "color": "#141D33"
              }
            },
            "titleFontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#F8FAFC"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#52627A"
              }
            },
            "gridlineColor": {
              "solid": {
                "color": "#1B2540"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#05080F"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#7C8BA3"
              }
            },
            "textSize": 9,
            "show": true
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "background": {
              "solid": {
                "color": "#141D33"
              }
            },
            "textSize": 10,
            "outlineColor": {
              "solid": {
                "color": "#22D3EE"
              }
            }
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1B2540"
              }
            },
            "outlineColor": {
              "solid": {
                "color": "#1B2540"
              }
            },
            "rowPadding": 7,
            "textSize": 10
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1222"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 10,
            "wordWrap": true
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#111A2E"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#0E1628"
              }
            }
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": {
              "solid": {
                "color": "#0A1020"
              }
            },
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#0A1020"
              }
            },
            "rowPadding": 9
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#94A3B8"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0B1222"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "alignment": "Center"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#CBD5E1"
              }
            },
            "backColor": {
              "solid": {
                "color": "#0E1628"
              }
            }
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#111A2E"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#111A2E"
              }
            }
          }
        ],
        "subTotals": [
          {
            "rowSubtotals": false,
            "columnSubtotals": false
          }
        ]
      }
    }
  }
}