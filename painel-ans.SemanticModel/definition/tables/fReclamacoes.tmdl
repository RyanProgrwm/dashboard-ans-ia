	partition fReclamacoes = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fato_reclamacoes.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Cabecalhos = Table.PromoteHeaders(Fonte, [PromoteAllScalars = true]),
				    Tipos = Table.TransformColumnTypes(Cabecalhos, {{"id_demanda", type text}, {"data_abertura", type date}, {"id_operadora", type text}, {"id_assunto", Int64.Type}, {"uf", type text}, {"id_faixa_etaria", Int64.Type}, {"Idade", Int64.Type}, {"Sexo", type text}, {"Tipo de Plano", type text}, {"Canal", type text}, {"Natureza", type text}, {"Resposta", type text}, {"fl_respondida", Int64.Type}, {"fl_resolvida", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
